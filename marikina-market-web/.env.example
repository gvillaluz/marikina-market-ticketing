# Client-visible public configuration only. Never put server credentials here.
VITE_APP_NAME=Marikina Ticketing System
# The server's address, without /api and without a slash at the end, for example https://<your-app>.azurewebsites.net.
# Set it when building the website for Azure. Leave it empty in development.
VITE_API_BASE_URL=
# Development only: the website calls /api on its own address and forwards it to API_PROXY_TARGET.
API_PROXY_TARGET=http://127.0.0.1:5000
