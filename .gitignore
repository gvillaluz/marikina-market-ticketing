# Local migration/recovery files and database backups must never be published.
/.monorepo-migration/
/.workspace-backups/
/.recovery-*/
/backups/
/backup_db_marikina
*.dump
*.backup
*.sql.gz

# Existing application-specific ignore rules remain inside each application.
**/node_modules/
**/bin/
**/obj/
**/.dart_tool/
**/build/
**/dist/
**/coverage/
**/TestResults/
**/.env
**/.env.local
**/.env.*.local
**/appsettings.Local.json
**/appsettings.*.Local.json
**/Keys/*.json
*.pfx
*.p12
*.jks
*.keystore

# Local setup files; safe examples remain tracked.
**/.env.*
!**/.env.example
**/user-secrets.local.json
**/firebase.local.json
**/android/app/google-services.json
**/ios/Runner/GoogleService-Info.plist
**/android/key.properties
**/android/local.properties
/.verification/
